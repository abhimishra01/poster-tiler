---
import Page from '../layouts/Page.astro';
import site from '../site.config.ts';
import { withBase } from '../lib/url.ts';
---
<Page title="About" description={`About ${site.name}, a free poster tiler that runs in your browser.`}>
  <p>{site.name} turns one image into a multi-page PDF. You print the pages, trim them and tape them together to make a large poster. It is free, with no watermark and no sign-up.</p>
  <h2>Why we built it</h2>
  <p>Teachers, crafters and parents often need a poster bigger than their printer. The tools we found were slow, full of ads, or asked for money before the download. We wanted a simple one that shows the pages on your picture before you print.</p>
  <h2>How it works</h2>
  <p>You choose an image. The page works out the grid from your paper size, margin, overlap and poster size. The PDF is built inside your browser, so your picture never leaves your device.</p>
  <h2>Contact</h2>
  <p>Questions or ideas? Write to <a href={`mailto:${site.email}`}>{site.email}</a> or visit the <a href={withBase('/contact/')}>Contact page</a>.</p>
</Page>

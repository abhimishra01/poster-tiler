---
import Page from '../layouts/Page.astro';
import site from '../site.config.ts';
import { withBase } from '../lib/url.ts';
---
<Page title="About" description={`About ${site.name}, a free poster tiler that runs in your browser.`}>
  <p>{site.name} turns one image into a multi-page PDF. You print the pages, trim them and tape them together to make a large poster. It is free, with no watermark and no sign-up.</p>
  <h2>What it is for</h2>
  <p>Use it when you want a poster bigger than your printer can make. The tool shows the pages on your picture before you print. The PDF has no watermark and there is nothing to pay.</p>
  <h2>How it works</h2>
  <p>You choose an image. The page works out the grid from your paper size, margin, overlap and poster size. The PDF is built inside your browser, so your picture never leaves your device.</p>
  <h2>Who made this</h2>
  <p>This tool was built by <a href="https://bingemind.com/abhishek-mishra/">Abhishek Mishra</a>, a software development engineer (SDE) at Oqu AI, and is published by Bingemind.</p>
  <p>Phone and WhatsApp: <a href="tel:+916376068337">+91 63760 68337</a> (<a href="https://wa.me/916376068337" rel="noopener">message on WhatsApp</a>).</p>
  <h2>Contact</h2>
  <p>Questions or ideas? Write to <a href={site.contactHref}>{site.contactLabel}</a> or visit the <a href={withBase('/contact/')}>Contact page</a>.</p>
</Page>

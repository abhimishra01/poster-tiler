---
import Base from '../layouts/Base.astro';
import Tool from '../components/Tool.astro';
import AdSlot from '../components/AdSlot.astro';
import Article from '../components/Article.astro';
import Faq from '../components/Faq.astro';
import site from '../site.config.ts';
import { faq } from '../data/faq.ts';
import { cases } from '../data/cases.ts';
import { withBase } from '../lib/url.ts';

const base = `https://${site.domain}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: `${base}/`,
    description: site.description,
    applicationCategory: site.category,
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    inLanguage: site.locale,
    author: { '@type': 'Person', name: 'Abhishek Mishra', jobTitle: 'Software Development Engineer', worksFor: { '@type': 'Organization', name: 'Oqu AI' }, url: 'https://bingemind.com/abhishek-mishra/' },
    publisher: { '@type': 'Organization', name: 'Bingemind', url: 'https://bingemind.com/' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: 'Split an image across many pages, Letter, A4, Legal, A3, A5 and Tabloid paper, Overlap and margin control, Cut and glue marks, Page labels, Assembly map, Multi-page PDF without a watermark',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base jsonLd={jsonLd}>
  <section class="mx-auto max-w-5xl px-4 pt-8 sm:pt-10">
    <p class="mb-3 inline-block rounded-full bg-brand-soft px-3 py-1 text-sm font-medium text-brand-ink">{site.tagline}</p>
    <h1 class="max-w-3xl text-3xl font-extrabold leading-[1.08] tracking-tight [text-wrap:balance] sm:text-5xl">
      {site.h1}
    </h1>
    <p class="mt-3 max-w-2xl text-base text-muted sm:text-lg">{site.description}</p>
    <div class="mt-6"><Tool /></div>
    <AdSlot />
  </section>
  <Article />
  <section aria-labelledby="guides" class="mx-auto max-w-5xl px-4 pt-16">
    <h2 id="guides" class="text-2xl font-bold tracking-tight">Poster guides by size and paper</h2>
    <p class="mt-2 max-w-2xl text-muted">Each guide opens the tool with the right size set and lists how many sheets you need.</p>
    <ul class="mt-4 grid gap-x-6 gap-y-1 sm:grid-cols-2">
      {cases.map((c) => <li><a href={withBase(`/${c.slug}/`)} class="inline-block py-2 text-brand-ink underline underline-offset-4">{c.h1}</a></li>)}
    </ul>
  </section>
  <Faq />
</Base>

---
import { PAPER } from '../lib/tile.js';
---
<section id="tool" aria-label="Poster tiler" class="grid gap-4 lg:grid-cols-[21.5rem_minmax(0,1fr)] lg:items-start lg:gap-6">
  <!-- 1. Image -->
  <div class="rounded-2xl border border-line bg-card p-4 lg:col-start-1">
    <p class="field-label" id="img-h">1. Your image</p>
    <input id="file" type="file" accept="image/*" class="sr-only" aria-labelledby="img-h" />
    <label for="file" class="btn-ghost" id="file-btn" tabindex="0">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"/></svg>
      Choose an image
    </label>
    <p id="img-name" class="mt-2 min-h-[2.5rem] text-sm text-muted">Loading a sample picture. You can also drop or paste an image.</p>
  </div>

  <!-- Preview -->
  <div class="rounded-2xl border border-line bg-card p-3 sm:p-4 lg:col-start-2 lg:row-start-1 lg:row-span-3 lg:sticky lg:top-20" id="drop">
    <div id="preview" class="relative h-[19rem] overflow-hidden rounded-xl border border-line bg-paper sm:h-[30rem]" role="img" aria-label="Preview of the poster split into pages" aria-describedby="summary">
      <div id="preview-inner" class="absolute inset-0 p-2"></div>
    </div>
    <dl id="stats" class="mt-3 grid grid-cols-3 gap-2" aria-label="Poster summary">
      <div class="stat"><dt>Sheets</dt><dd id="st-sheets">&nbsp;</dd></div>
      <div class="stat"><dt>Poster size</dt><dd id="st-size">&nbsp;</dd></div>
      <div class="stat"><dt>Print quality</dt><dd id="st-quality">&nbsp;</dd></div>
    </dl>
    <div id="summary" aria-live="polite" aria-atomic="true" class="mt-3 min-h-[4.5rem] text-sm text-muted"></div>
  </div>

  <!-- 2. Settings -->
  <div class="space-y-5 rounded-2xl border border-line bg-card p-4 lg:col-start-1">
    <div>
      <label for="paper" class="field-label">2. Paper</label>
      <select id="paper" class="field">
        {Object.entries(PAPER).map(([k, v]) => <option value={k}>{v.name}</option>)}
      </select>
      <fieldset class="seg mt-2">
        <legend class="sr-only">Paper orientation</legend>
        <label><input type="radio" name="orient" value="portrait" checked /><span>Portrait</span></label>
        <label><input type="radio" name="orient" value="landscape" /><span>Landscape</span></label>
      </fieldset>
    </div>

    <div>
      <p class="field-label">3. Poster size</p>
      <fieldset class="seg">
        <legend class="sr-only">Set the poster size by</legend>
        <label><input type="radio" name="mode" value="across" checked /><span>Pages across</span></label>
        <label><input type="radio" name="mode" value="width" /><span>Width</span></label>
        <label><input type="radio" name="mode" value="height" /><span>Height</span></label>
      </fieldset>
      <label for="size" class="field-label mt-3" id="size-label">Pages across</label>
      <div class="flex gap-2">
        <button type="button" class="step-btn" id="size-minus" aria-label="Decrease">&minus;</button>
        <input id="size" class="field text-center font-semibold tabular-nums" type="number" inputmode="decimal" min="1" step="1" value="3" />
        <button type="button" class="step-btn" id="size-plus" aria-label="Increase">+</button>
      </div>
      <fieldset class="seg mt-2">
        <legend class="sr-only">Units</legend>
        <label><input type="radio" name="unit" value="in" checked /><span>Inches</span></label>
        <label><input type="radio" name="unit" value="cm" /><span>Centimeters</span></label>
      </fieldset>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label for="margin" class="field-label">Printer margin (<span class="unit-name">in</span>)</label>
        <input id="margin" class="field tabular-nums" type="number" inputmode="decimal" min="0" step="0.05" value="0.25" />
      </div>
      <div>
        <label for="overlap" class="field-label">Overlap (<span class="unit-name">in</span>)</label>
        <input id="overlap" class="field tabular-nums" type="number" inputmode="decimal" min="0" step="0.05" value="0.5" />
      </div>
    </div>
    <p class="-mt-2 text-xs text-muted">Most home printers cannot print within 0.25 in (6 mm) of the edge. The overlap is the strip you glue.</p>

    <div class="border-t border-line pt-2">
      <label class="chk"><input type="checkbox" id="opt-marks" checked /> Cut and glue marks</label>
      <label class="chk"><input type="checkbox" id="opt-labels" checked /> Page labels (A1, A2, ...)</label>
      <label class="chk"><input type="checkbox" id="opt-map" /> Add an assembly map page</label>
    </div>
  </div>

  <!-- 3. Download -->
  <div class="rounded-2xl border border-line bg-card p-4 lg:col-start-1">
    <button type="button" id="download" class="btn-primary" disabled>Download PDF</button>
    <p id="dl-status" role="status" aria-live="polite" class="mt-2 min-h-[2.5rem] text-sm text-muted">Print at 100% or Actual size. Do not choose Fit to page.</p>
  </div>
  <noscript><p class="rounded-xl border border-line bg-card p-4">This tool needs JavaScript. Turn it on to split your image into pages.</p></noscript>
</section>

<script>
  import { layout, wasteTip, fromInches, tileLabel, tileOrigin } from '../lib/tile.js';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const radio = (name: string) => (document.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement).value;
  const round = (v: number, d = 2) => Math.round(v * 10 ** d) / 10 ** d;

  type Src = { blob: Blob; url: string; w: number; h: number; name: string; sample: boolean };
  let src: Src | null = null;
  let current: any = null;
  let busy = false;

  // Values stay in the unit on screen. Width and height keep their own values per mode.
  const vals = { across: 3, width: 24, height: 36 };
  let unit: 'in' | 'cm' = 'in';

  const sizeInput = $<HTMLInputElement>('size');
  const marginInput = $<HTMLInputElement>('margin');
  const overlapInput = $<HTMLInputElement>('overlap');
  const mode = () => radio('mode') as 'across' | 'width' | 'height';

  function syncSizeInput() {
    const m = mode();
    sizeInput.value = String(vals[m]);
    sizeInput.step = m === 'across' ? '1' : unit === 'in' ? '1' : '2';
    $('size-label').textContent = m === 'across' ? 'Pages across' : (m === 'width' ? 'Poster width' : 'Poster height') + ` (${unit === 'in' ? 'inches' : 'centimeters'})`;
    document.querySelectorAll('.unit-name').forEach((e) => (e.textContent = unit));
    marginInput.step = overlapInput.step = unit === 'in' ? '0.05' : '0.1';
  }

  /* ---------- Preview ---------- */
  function renderPreview() {
    const box = $('preview-inner');
    if (!src || !current || !current.ok) return;
    const L = current;
    const pad = Math.max(L.gridW, L.gridH) * 0.01;
    const vb = `${-pad} ${-pad} ${L.gridW + 2 * pad} ${L.gridH + 2 * pad}`;
    const fs = Math.min(L.printW, L.printH) * 0.2;
    let boxes = '', ovl = '', labels = '';
    for (let r = 0; r < L.rows; r++) {
      for (let c = 0; c < L.cols; c++) {
        const o = tileOrigin(L, c, r);
        boxes += `<rect x="${o.x}" y="${o.y}" width="${L.printW}" height="${L.printH}" fill="${(c + r) % 2 ? 'rgba(0,0,0,.10)' : 'none'}" stroke="var(--brand)" stroke-width="1.5" vector-effect="non-scaling-stroke"/>`;
        if (c < L.cols - 1 && L.overlap > 0) ovl += `<rect x="${o.x + L.stepX}" y="${o.y}" width="${L.overlap}" height="${L.printH}"/>`;
        if (r < L.rows - 1 && L.overlap > 0) ovl += `<rect x="${o.x}" y="${o.y + L.stepY}" width="${L.printW}" height="${L.overlap}"/>`;
        labels += `<text x="${o.x + L.printW / 2}" y="${o.y + L.printH / 2 + fs * 0.35}" text-anchor="middle" font-size="${fs}" stroke-width="${fs * 0.12}">${tileLabel(c, r)}</text>`;
      }
    }
    box.innerHTML = `<svg class="preview-svg" viewBox="${vb}" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <defs><pattern id="hatch" width="0.5" height="0.5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="0.5" height="0.5" fill="var(--card)"/><line x1="0" y1="0" x2="0" y2="0.5" stroke="var(--line)" stroke-width="0.12"/></pattern></defs>
      <rect x="0" y="0" width="${L.gridW}" height="${L.gridH}" fill="url(#hatch)"/>
      <image href="${src.url}" x="0" y="0" width="${L.posterW}" height="${L.posterH}" preserveAspectRatio="none"/>
      <g fill="var(--brand)" fill-opacity=".38">${ovl}</g>
      ${boxes}${labels}
    </svg>`;
  }

  /* ---------- Summary ---------- */
  function update() {
    const dl = $<HTMLButtonElement>('download');
    const sum = $('summary');
    if (!src) return;
    const L = layout({
      imgW: src.w, imgH: src.h, paper: ($('paper') as HTMLSelectElement).value, orientation: radio('orient'),
      mode: mode(), value: vals[mode()], unit, margin: parseFloat(marginInput.value), overlap: parseFloat(overlapInput.value),
    });
    current = L;
    if (!L.ok) {
      sum.textContent = L.error;
      sum.className = 'mt-3 min-h-[4.5rem] text-sm font-medium text-brand-ink';
      dl.disabled = true;
      return;
    }
    sum.className = 'mt-3 min-h-[4.5rem] text-sm text-muted';
    const f = (v: number) => round(fromInches(v, unit), 1);
    $('st-sheets').textContent = `${L.sheets} (${L.cols} × ${L.rows})`;
    $('st-size').textContent = `${f(L.posterW)} × ${f(L.posterH)} ${unit}`;
    $('st-quality').textContent = `${Math.round(L.dpi)} dpi, ${L.quality.level}`;
    const lines = [
      `${L.cols} pages across and ${L.rows} down. Each page prints ${f(L.printW)} × ${f(L.printH)} ${unit} of the picture.`,
      `At ${Math.round(L.dpi)} dpi the poster looks ${L.quality.text}.`,
      ...wasteTip(L, unit),
    ];
    sum.innerHTML = lines.map((t) => `<p class="mb-1">${t}</p>`).join('');
    if (!busy) {
      dl.disabled = false;
      const pages = L.sheets + (($('opt-map') as HTMLInputElement).checked ? 1 : 0);
      dl.textContent = `Download PDF (${pages} ${pages === 1 ? 'page' : 'pages'})`;
    }
    renderPreview();
  }

  /* ---------- Image loading ---------- */
  async function decode(blob: Blob): Promise<{ w: number; h: number }> {
    try {
      const bmp = await createImageBitmap(blob);
      const r = { w: bmp.width, h: bmp.height };
      bmp.close();
      return r;
    } catch {
      return new Promise((res, rej) => {
        const u = URL.createObjectURL(blob);
        const im = new Image();
        im.onload = () => { res({ w: im.naturalWidth, h: im.naturalHeight }); URL.revokeObjectURL(u); };
        im.onerror = () => { rej(new Error('decode')); URL.revokeObjectURL(u); };
        im.src = u;
      });
    }
  }

  async function setSource(blob: Blob, name: string, sample = false) {
    try {
      const { w, h } = await decode(blob);
      if (!w || !h) throw new Error('size');
      if (src) URL.revokeObjectURL(src.url);
      src = { blob, url: URL.createObjectURL(blob), w, h, name, sample };
      $('img-name').textContent = sample
        ? 'Sample picture shown. Choose your own image to replace it.'
        : `${name}, ${w} × ${h} pixels. It stays on your device.`;
      update();
    } catch {
      $('img-name').textContent = 'This browser cannot open that file. Try a JPG or PNG image.';
    }
  }

  function makeSample(): Promise<Blob> {
    const c = document.createElement('canvas');
    c.width = 1800; c.height = 1200;
    const g = c.getContext('2d')!;
    const sky = g.createLinearGradient(0, 0, 0, 800);
    sky.addColorStop(0, '#2b5fa8'); sky.addColorStop(1, '#f6d7a8');
    g.fillStyle = sky; g.fillRect(0, 0, 1800, 1200);
    g.fillStyle = '#fff6d8'; g.beginPath(); g.arc(1330, 300, 130, 0, Math.PI * 2); g.fill();
    const hill = (y: number, col: string, amp: number, ph: number) => {
      g.fillStyle = col; g.beginPath(); g.moveTo(0, 1200);
      for (let x = 0; x <= 1800; x += 20) g.lineTo(x, y + Math.sin(x / 260 + ph) * amp);
      g.lineTo(1800, 1200); g.closePath(); g.fill();
    };
    hill(640, '#c9794a', 70, 0.5); hill(780, '#8f4a2c', 90, 2); hill(930, '#4a2a22', 60, 4);
    g.fillStyle = '#fff'; g.font = '700 150px ui-sans-serif, system-ui, sans-serif'; g.textAlign = 'center';
    g.fillText('Your poster', 900, 1110);
    return new Promise((res) => c.toBlob((b) => res(b!), 'image/png'));
  }

  const fileInput = $<HTMLInputElement>('file');
  fileInput.addEventListener('change', () => { const f = fileInput.files?.[0]; if (f) setSource(f, f.name); });
  $('file-btn').addEventListener('keydown', (e) => { const k = (e as KeyboardEvent).key; if (k === 'Enter' || k === ' ') { e.preventDefault(); fileInput.click(); } });
  const drop = $('drop');
  ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('ring-2', 'ring-brand'); }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove('ring-2', 'ring-brand'); }));
  drop.addEventListener('drop', (e) => { const f = (e as DragEvent).dataTransfer?.files?.[0]; if (f && f.type.startsWith('image/')) setSource(f, f.name); });
  document.addEventListener('paste', (e) => {
    const f = Array.from(e.clipboardData?.files || []).find((x) => x.type.startsWith('image/'));
    if (f) setSource(f, f.name || 'Pasted image');
  });

  /* ---------- Settings ---------- */
  sizeInput.addEventListener('input', () => { const v = parseFloat(sizeInput.value); vals[mode()] = isNaN(v) ? 0 : v; update(); });
  const nudge = (d: number) => {
    const m = mode();
    const step = m === 'across' ? 1 : unit === 'in' ? 1 : 2;
    vals[m] = Math.max(step, round((vals[m] || 0) + d * step, 2));
    sizeInput.value = String(vals[m]);
    update();
  };
  $('size-minus').addEventListener('click', () => nudge(-1));
  $('size-plus').addEventListener('click', () => nudge(1));
  document.querySelectorAll('input[name="mode"]').forEach((e) => e.addEventListener('change', () => { syncSizeInput(); update(); }));
  document.querySelectorAll('input[name="unit"]').forEach((e) => e.addEventListener('change', () => {
    const next = radio('unit') as 'in' | 'cm';
    if (next === unit) return;
    const k = next === 'cm' ? 2.54 : 1 / 2.54;
    vals.width = round(vals.width * k, 1); vals.height = round(vals.height * k, 1);
    marginInput.value = String(round(parseFloat(marginInput.value || '0') * k));
    overlapInput.value = String(round(parseFloat(overlapInput.value || '0') * k));
    unit = next;
    syncSizeInput(); update();
  }));
  ['paper', 'margin', 'overlap', 'opt-map'].forEach((id) => $(id).addEventListener('input', update));
  document.querySelectorAll('input[name="orient"]').forEach((e) => e.addEventListener('change', update));

  /* ---------- PDF ---------- */
  const isIOS = /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

  async function prepareJpeg(blob: Blob, posterIn: number): Promise<Uint8Array> {
    const bmp = await createImageBitmap(blob);
    const maxSide = isIOS ? 4096 : 10000;
    const maxPix = isIOS ? 16e6 : 64e6;
    let scale = Math.min(1, maxSide / Math.max(bmp.width, bmp.height), Math.sqrt(maxPix / (bmp.width * bmp.height)), (300 * posterIn) / bmp.width);
    for (let attempt = 0; attempt < 5; attempt++) {
      const c = document.createElement('canvas');
      c.width = Math.max(1, Math.round(bmp.width * scale));
      c.height = Math.max(1, Math.round(bmp.height * scale));
      const g = c.getContext('2d');
      if (g) {
        g.fillStyle = '#fff'; g.fillRect(0, 0, c.width, c.height);
        g.imageSmoothingQuality = 'high';
        g.drawImage(bmp, 0, 0, c.width, c.height);
        const out: Blob | null = await new Promise((res) => c.toBlob(res, 'image/jpeg', 0.92));
        if (out && out.size > 0) { bmp.close(); return new Uint8Array(await out.arrayBuffer()); }
      }
      scale *= 0.7;
    }
    bmp.close();
    throw new Error('canvas');
  }

  $('download').addEventListener('click', async () => {
    if (!src || !current || !current.ok || busy) return;
    const L = current, btn = $<HTMLButtonElement>('download'), status = $('dl-status');
    busy = true; btn.disabled = true; btn.textContent = 'Building PDF...';
    status.textContent = 'Preparing your image...';
    try {
      const [lib, { buildPdf }] = await Promise.all([import('pdf-lib'), import('../lib/pdf.js')]);
      const jpg = await prepareJpeg(src.blob, L.posterW);
      const bytes = await buildPdf(lib, L, { bytes: jpg, type: 'jpg' }, {
        marks: ($('opt-marks') as HTMLInputElement).checked,
        labels: ($('opt-labels') as HTMLInputElement).checked,
        map: ($('opt-map') as HTMLInputElement).checked,
      }, (d: number, t: number) => { status.textContent = `Building page ${d} of ${t}...`; });
      const url = URL.createObjectURL(new Blob([bytes as BlobPart], { type: 'application/pdf' }));
      const a = document.createElement('a');
      a.href = url; a.download = `poster-${L.cols}x${L.rows}-pages.pdf`;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 60000);
      status.textContent = 'Done. Open the PDF and print at 100% or Actual size. Do not choose Fit to page.';
    } catch {
      status.textContent = 'The PDF could not be built. Try a smaller image or a smaller poster.';
    } finally {
      busy = false; btn.disabled = false; update();
    }
  });

  /* ---------- Start ---------- */
  syncSizeInput();
  makeSample().then((b) => setSource(b, 'Sample', true));
</script>

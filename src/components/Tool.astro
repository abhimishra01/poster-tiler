---
import { PAPER } from '../lib/tile.js';
// A landing page can start the tool on a set case: { paper, orient, mode, value, unit }.
const { preset = null } = Astro.props;
---
<section id="tool" aria-label="Poster tiler" data-preset={preset ? JSON.stringify(preset) : undefined} class="grid gap-4 lg:grid-cols-[21.5rem_minmax(0,1fr)] lg:items-start lg:gap-6">
  <!-- 1. Image -->
  <div class="rounded-2xl border border-line bg-card p-4 lg:col-start-1">
    <p class="field-label" id="img-h">1. Your image</p>
    <input id="file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,image/avif" class="sr-only" aria-labelledby="img-h" />
    <label for="file" class="btn-ghost" id="file-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"/></svg>
      Choose an image
    </label>
    <p id="img-name" class="mt-2 min-h-[2.5rem] text-sm text-muted">Loading a sample picture. You can also drop or paste an image.</p>
  </div>

  <!-- Preview -->
  <div class="rounded-2xl border border-line bg-card p-3 sm:p-4 lg:col-start-2 lg:row-start-1 lg:row-span-3 lg:sticky lg:top-20 flex flex-col gap-3 " id="drop">
    <div id="preview" class="relative h-[19rem] overflow-hidden rounded-xl border border-line bg-paper sm:h-[30rem] lg:order-3 lg:h-[24rem]" role="img" aria-label="Preview of the poster split into pages" aria-describedby="summary">
      <div id="preview-inner" class="absolute inset-0 p-2"></div>
    </div>
    <p class="-mt-1 text-xs text-muted lg:order-4">Hatched area is blank paper. A shaded strip is overlap you glue. A1, A2 and so on are the page names.</p>
    <dl id="stats" class="grid grid-cols-3 gap-2 lg:order-1" aria-label="Poster summary">
      <div class="stat"><dt>Sheets</dt><dd id="st-sheets">&nbsp;</dd></div>
      <div class="stat"><dt>Poster size</dt><dd id="st-size">&nbsp;</dd></div>
      <div class="stat"><dt>Print quality</dt><dd id="st-quality">&nbsp;</dd></div>
    </dl>
    <div class="lg:hidden">
      <button type="button" class="btn-ghost test-btn" disabled>Print a test page first (A1 only)</button>
      <p role="status" class="dl-status mt-2 text-sm font-semibold text-ink">Print at 100% (Actual size). Do not choose Fit to page.</p>
    </div>
    <div class="hidden lg:order-2 lg:block">
      <button type="button" class="btn-primary dl-btn" disabled>Download PDF</button>
      <button type="button" class="btn-ghost test-btn mt-2" disabled>Print a test page first (A1 only)</button>
      <p role="status" class="dl-status mt-2 text-sm font-semibold text-ink">Print at 100% (Actual size). Do not choose Fit to page.</p>
    </div>
    <div id="summary" aria-live="polite" aria-atomic="true" class="min-h-[4.5rem] text-sm text-muted lg:order-5"></div>
    <div class="text-sm text-muted lg:order-6">
      <p class="font-semibold text-ink">How to assemble</p>
      <ol class="mt-1 list-decimal space-y-0.5 pl-5">
        <li>Print one page and check it. Print at 100%.</li>
        <li>Trim the white edge along the solid marks. Keep the dashed edges.</li>
        <li>Line up pages A1 and A2, then B1 and B2. Glue each strip.</li>
      </ol>
    </div>
  </div>

  <!-- 2. Settings -->
  <div class="space-y-5 rounded-2xl border border-line bg-card p-4 lg:col-start-1">
    <div>
      <label for="paper" class="field-label">2. Paper</label>
      <select id="paper" class="field">
        {Object.entries(PAPER).map(([k, v]) => <option value={k}>{v.name}</option>)}
      </select>
      <fieldset class="seg mt-2">
        <legend class="sr-only">Paper orientation</legend>
        <label><input type="radio" name="orient" value="portrait" checked /><span>Portrait</span></label>
        <label><input type="radio" name="orient" value="landscape" /><span>Landscape</span></label>
      </fieldset>
    </div>

    <div>
      <p class="field-label">3. Poster size</p>
      <fieldset class="seg">
        <legend class="sr-only">How the picture fills the poster</legend>
        <label><input type="radio" name="fit" value="fit" checked /><span>Fit</span></label>
        <label><input type="radio" name="fit" value="fill" /><span>Fill</span></label>
      </fieldset>
      <p id="fit-note" class="mt-1 text-xs text-muted">Fit shows the whole picture. The poster may have white at the edges.</p>

      <div id="fit-fields" class="mt-3">
        <fieldset class="seg">
          <legend class="sr-only">Set the poster size by</legend>
          <label><input type="radio" name="mode" value="across" checked /><span>Across</span></label>
          <label><input type="radio" name="mode" value="width" /><span>Width</span></label>
          <label><input type="radio" name="mode" value="height" /><span>Height</span></label>
        </fieldset>
        <label for="size" class="field-label mt-3" id="size-label">Pages across</label>
        <div class="flex gap-2">
          <button type="button" class="step-btn" id="size-minus" aria-label="Decrease">&minus;</button>
          <input id="size" class="field text-center font-semibold tabular-nums" type="number" inputmode="decimal" min="1" step="1" value="3" />
          <button type="button" class="step-btn" id="size-plus" aria-label="Increase">+</button>
        </div>
      </div>

      <div id="fill-fields" class="mt-3" hidden>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="fill-w" class="field-label">Width (<span class="unit-name">in</span>)</label>
            <input id="fill-w" class="field tabular-nums" type="number" inputmode="decimal" min="1" step="1" />
          </div>
          <div>
            <label for="fill-h" class="field-label">Height (<span class="unit-name">in</span>)</label>
            <input id="fill-h" class="field tabular-nums" type="number" inputmode="decimal" min="1" step="1" />
          </div>
        </div>
        <p class="field-label mt-3" id="crop-h">What stays in the poster</p>
        <div id="crop-box" class="mt-1 flex justify-center rounded-xl border border-line bg-paper p-2">
          <svg id="crop-svg" class="block max-h-44 w-full touch-none cursor-grab select-none" tabindex="0" role="group" aria-labelledby="crop-h" aria-describedby="crop-note"></svg>
        </div>
        <p id="crop-note" class="mt-1 text-xs text-muted" aria-live="polite"></p>
      </div>

      <fieldset class="seg mt-3">
        <legend class="sr-only">Units</legend>
        <label><input type="radio" name="unit" value="in" checked /><span>Inches</span></label>
        <label><input type="radio" name="unit" value="cm" /><span>Centimeters</span></label>
      </fieldset>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label for="margin" class="field-label">Printer margin (<span class="unit-name">in</span>)</label>
        <input id="margin" class="field tabular-nums" type="number" inputmode="decimal" min="0" step="0.05" value="0.25" />
      </div>
      <div>
        <label for="overlap" class="field-label">Overlap, glue strip (<span class="unit-name">in</span>)</label>
        <input id="overlap" class="field tabular-nums" type="number" inputmode="decimal" min="0" step="0.05" value="0.5" />
      </div>
    </div>
    <p class="-mt-2 text-xs text-muted">Most home printers cannot print within 0.25 in (6 mm) of the edge. The overlap is the strip you glue.</p>

    <div class="border-t border-line pt-2">
      <label class="chk"><input type="checkbox" id="opt-marks" checked /> Cut and glue marks</label>
      <label class="chk"><input type="checkbox" id="opt-labels" checked /> Page labels (A1, A2, ...)</label>
      <label class="chk"><input type="checkbox" id="opt-map" /> Add an assembly map page</label>
    </div>
  </div>

  <!-- Download bar on phones: one row. It stays at the bottom of the screen while you change settings. -->
  <div class="sticky bottom-2 z-10 flex h-16 items-center gap-3 rounded-2xl border border-line bg-card px-3 shadow-lg lg:hidden">
    <div class="min-w-0 flex-1 leading-tight" aria-live="polite">
      <p id="bar-sheets" class="truncate text-base font-extrabold tabular-nums">&nbsp;</p>
      <p id="bar-size" class="truncate text-xs text-muted tabular-nums">&nbsp;</p>
    </div>
    <button type="button" class="btn-primary dl-btn bar-btn" disabled>Download</button>
  </div>
  <noscript><p class="rounded-xl border border-line bg-card p-4">This tool needs JavaScript. Turn it on to split your image into pages.</p></noscript>
</section>

<script>
  import { layout, wasteTip, showLen, toInches, tileLabel, tileOrigin, cropRect } from '../lib/tile.js';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const all = (sel: string) => Array.from(document.querySelectorAll<HTMLElement>(sel));
  const radio = (name: string) => (document.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement).value;

  type Src = { blob: Blob; url: string; w: number; h: number; sample: boolean };
  let src: Src | null = null;
  let current: any = null;
  let tips: { text: string; fix: { mode: 'width' | 'height'; inches: number } }[] = [];
  let busy = false;
  let statusKind: 'note' | 'invalid' | 'failed' | 'progress' | 'done' = 'note';
  const NOTE = 'Print at 100% (Actual size). Do not choose Fit to page.';

  // Every length is stored in inches. The unit only changes what is shown, so switching units never drifts.
  const vals = { across: 3, width: 24, height: 36 };
  let marginIn = 0.25;
  let overlapIn = 0.5;
  let unit: 'in' | 'cm' = 'in';
  // Fill crops the picture to the exact poster size. fx and fy place the kept window (0 to 1, 0.5 is the center).
  const crop = { fx: 0.5, fy: 0.5 };
  const isFill = () => radio('fit') === 'fill';

  const sizeInput = $<HTMLInputElement>('size');
  const marginInput = $<HTMLInputElement>('margin');
  const overlapInput = $<HTMLInputElement>('overlap');
  const fillW = $<HTMLInputElement>('fill-w');
  const fillH = $<HTMLInputElement>('fill-h');
  const mode = () => radio('mode') as 'across' | 'width' | 'height';
  // Step of the plus and minus buttons, in the unit on screen.
  const stepFor = (m: string) => (m === 'across' || unit === 'in' ? 1 : 2);

  function syncInputs() {
    const m = mode();
    sizeInput.value = String(m === 'across' ? vals.across : showLen(vals[m], unit));
    sizeInput.step = String(stepFor(m));
    const unitWord = unit === 'in' ? 'inches' : 'centimeters';
    $('size-label').textContent = m === 'across' ? 'Pages across' : `${m === 'width' ? 'Poster width' : 'Poster height'} (${unitWord})`;
    all('.unit-name').forEach((e) => (e.textContent = unit));
    fillW.value = String(showLen(vals.width, unit)); fillH.value = String(showLen(vals.height, unit));
    fillW.step = fillH.step = String(unit === 'in' ? 1 : 2);
    const fill = isFill();
    $('fit-fields').hidden = fill; $('fill-fields').hidden = !fill;
    $('fit-note').textContent = fill
      ? 'Fill gives exactly the size you type. The picture is cropped to that shape.'
      : 'Fit shows the whole picture. The poster may have white at the edges.';
    marginInput.step = overlapInput.step = unit === 'in' ? '0.05' : '0.1';
    marginInput.value = String(showLen(marginIn, unit, 3));
    overlapInput.value = String(showLen(overlapIn, unit, 3));
  }

  // The phone bar button only says Download. The sheet count sits beside it.
  function dlText(b: HTMLElement, pages = 0) {
    if (b.classList.contains('bar-btn')) return 'Download';
    return pages ? `Download ${src?.sample ? 'sample ' : ''}PDF (${pages} ${pages === 1 ? 'page' : 'pages'})` : 'Download PDF';
  }

  function setStatus(text: string, kind: typeof statusKind) {
    statusKind = kind;
    all('.dl-status').forEach((e) => { e.textContent = text; });
  }

  /* ---------- Preview ---------- */
  function renderPreview() {
    const box = $('preview-inner');
    if (!src || !current || !current.ok) return;
    const L = current;
    const pad = Math.max(L.gridW, L.gridH) * 0.01;
    const vb = `${-pad} ${-pad} ${L.gridW + 2 * pad} ${L.gridH + 2 * pad}`;
    const fs = Math.min(L.printW, L.printH) * 0.2;
    let boxes = '', ovl = '', labels = '';
    for (let r = 0; r < L.rows; r++) {
      for (let c = 0; c < L.cols; c++) {
        const o = tileOrigin(L, c, r);
        boxes += `<rect x="${o.x}" y="${o.y}" width="${L.printW}" height="${L.printH}" fill="${(c + r) % 2 ? 'rgba(0,0,0,.10)' : 'none'}" stroke="var(--brand)" stroke-width="1.5" vector-effect="non-scaling-stroke"/>`;
        if (c < L.cols - 1 && L.overlap > 0) ovl += `<rect x="${o.x + L.stepX}" y="${o.y}" width="${L.overlap}" height="${L.printH}"/>`;
        if (r < L.rows - 1 && L.overlap > 0) ovl += `<rect x="${o.x}" y="${o.y + L.stepY}" width="${L.printW}" height="${L.overlap}"/>`;
        labels += `<text x="${o.x + L.printW / 2}" y="${o.y + L.printH / 2 + fs * 0.35}" text-anchor="middle" font-size="${fs}" stroke-width="${fs * 0.12}">${tileLabel(c, r)}</text>`;
      }
    }
    box.innerHTML = `<svg class="preview-svg" viewBox="${vb}" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <defs><pattern id="hatch" width="0.5" height="0.5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="0.5" height="0.5" fill="var(--card)"/><line x1="0" y1="0" x2="0" y2="0.5" stroke="var(--line)" stroke-width="0.12"/></pattern></defs>
      <rect x="0" y="0" width="${L.gridW}" height="${L.gridH}" fill="url(#hatch)"/>
      <svg x="0" y="0" width="${L.posterW}" height="${L.posterH}" viewBox="${L.crop.sx} ${L.crop.sy} ${L.crop.sw} ${L.crop.sh}" preserveAspectRatio="none"><image href="${src.url}" x="0" y="0" width="${src.w}" height="${src.h}" preserveAspectRatio="none"/></svg>
      <g fill="var(--brand)" fill-opacity=".38">${ovl}</g>
      ${boxes}${labels}
    </svg>`;
  }

  /* ---------- Crop preview (Fill) ---------- */
  // Shows the whole picture with the part that stays lit. Drag it, or use the arrow keys, to move the part that stays.
  function renderCrop() {
    const svg = $('crop-svg');
    const L = current;
    if (!src || !L || !L.ok || !L.fill) return;
    const { sx, sy, sw, sh } = L.crop;
    const sw2 = Math.max(src.w, 1), sh2 = Math.max(src.h, 1);
    const line = Math.max(src.w, src.h) * 0.006;
    svg.setAttribute('viewBox', `0 0 ${src.w} ${src.h}`);
    svg.style.aspectRatio = `${src.w} / ${src.h}`;
    svg.innerHTML = `<image href="${src.url}" x="0" y="0" width="${sw2}" height="${sh2}" preserveAspectRatio="none"/>
      <path fill-rule="evenodd" fill="rgba(0,0,0,.58)" d="M0 0H${src.w}V${src.h}H0Z M${sx} ${sy}h${sw}v${sh}h${-sw}Z"/>
      <rect x="${sx}" y="${sy}" width="${sw}" height="${sh}" fill="none" stroke="#fff" stroke-width="${line * 2.5}"/>
      <rect x="${sx}" y="${sy}" width="${sw}" height="${sh}" fill="none" stroke="var(--brand)" stroke-width="${line}"/>`;
    const slack = L.crop.cutPct > 0;
    svg.style.cursor = slack ? 'grab' : 'default';
    svg.setAttribute('aria-label', slack ? 'Picture with the kept part outlined. Drag, or use the arrow keys, to move it.' : 'Picture with the kept part outlined. All of it stays.');
    $('crop-note').textContent = slack
      ? `About ${L.crop.cutPct}% of the picture is cut off (the dark part). Drag the box to choose what stays.`
      : 'The picture already has this shape. Nothing is cut off.';
  }
  (() => {
    const svg = $('crop-svg');
    let drag: { x: number; y: number; fx: number; fy: number } | null = null;
    // Move the window by a share of the spare picture on each side.
    const move = (dx: number, dy: number, fx0: number, fy0: number, scale: number) => {
      if (!src || !current || !current.ok || !current.fill) return;
      const { sw, sh } = current.crop;
      const slackX = src.w - sw, slackY = src.h - sh;
      if (slackX > 1e-6) crop.fx = Math.min(1, Math.max(0, fx0 + (dx * scale) / slackX));
      if (slackY > 1e-6) crop.fy = Math.min(1, Math.max(0, fy0 + (dy * scale) / slackY));
      update();
    };
    svg.addEventListener('pointerdown', (e) => {
      drag = { x: e.clientX, y: e.clientY, fx: crop.fx, fy: crop.fy };
      svg.setPointerCapture(e.pointerId); svg.style.cursor = 'grabbing';
    });
    svg.addEventListener('pointermove', (e) => {
      if (!drag || !src) return;
      const r = svg.getBoundingClientRect();
      move(e.clientX - drag.x, e.clientY - drag.y, drag.fx, drag.fy, src.w / r.width);
    });
    const end = () => { drag = null; svg.style.cursor = current?.crop?.cutPct ? 'grab' : 'default'; };
    svg.addEventListener('pointerup', end); svg.addEventListener('pointercancel', end);
    svg.addEventListener('keydown', (e) => {
      const k: Record<string, [number, number]> = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
      if (!k[e.key] || !src) return;
      e.preventDefault();
      move(k[e.key][0], k[e.key][1], crop.fx, crop.fy, src.w * 0.03);
    });
  })();

  /* ---------- Summary ---------- */
  function update() {
    const sum = $('summary');
    if (!src) return;
    const L = layout({
      imgW: src.w, imgH: src.h, paper: ($('paper') as HTMLSelectElement).value, orientation: radio('orient'),
      mode: mode(), value: vals[mode()], unit: 'in', margin: marginIn, overlap: overlapIn,
      fit: radio('fit'), fillW: vals.width, fillH: vals.height, fx: crop.fx, fy: crop.fy,
    });
    current = L;
    const dls = all('.dl-btn') as HTMLButtonElement[];
    const tests = all('.test-btn') as HTMLButtonElement[];
    $('preview').classList.toggle('opacity-40', !L.ok);
    if (!L.ok) {
      // Clear the numbers so old values do not sit beside an error.
      ['st-sheets', 'st-size', 'st-quality', 'bar-sheets', 'bar-size'].forEach((id) => { $(id).textContent = '-'; });
      tips = [];
      sum.textContent = L.error;
      sum.className = 'min-h-[4.5rem] text-sm font-medium text-brand-ink lg:order-5';
      dls.forEach((b) => { b.disabled = true; b.textContent = dlText(b); });
      tests.forEach((b) => { b.disabled = true; });
      if (!busy) setStatus(L.error, 'invalid');
      return;
    }
    if (statusKind === 'invalid') setStatus(NOTE, 'note');
    sum.className = 'min-h-[4.5rem] text-sm text-muted lg:order-5';
    const f = (v: number) => showLen(v, unit, 1);
    $('st-sheets').textContent = `${L.sheets} (${L.cols} × ${L.rows})`;
    $('st-size').textContent = `${f(L.posterW)} × ${f(L.posterH)} ${unit}`;
    $('bar-sheets').textContent = `${L.sheets} ${L.sheets === 1 ? 'sheet' : 'sheets'} (${L.cols} × ${L.rows})`;
    $('bar-size').textContent = `${f(L.posterW)} × ${f(L.posterH)} ${unit}${L.fill && L.crop.cutPct ? `, ${L.crop.cutPct}% cut off` : ''}`;
    $('st-quality').textContent = `${Math.round(L.dpi)} dpi, ${L.quality.level}`;
    tips = wasteTip(L, unit);
    const qcheck = L.fill && L.dpi < 150
      ? `Quality check: looks sharp at 150 dpi or more. Yours is ${Math.round(L.dpi)} dpi. Make the poster smaller or use a bigger image.`
      : L.dpi >= 150
      ? `Quality check: ${Math.round(L.dpi)} dpi. This looks sharp. 150 dpi or more is enough.`
      : `Quality check: looks sharp at 150 dpi or more. Yours is ${Math.round(L.dpi)} dpi. Pick fewer pages or a bigger image. This image gives 150 dpi up to ${f(src.w / 150)} ${unit} wide.`;
    const lines = [
      `<p class="mb-1">${L.cols} pages across and ${L.rows} down. Each page prints ${f(L.printW)} × ${f(L.printH)} ${unit} of the picture. ${L.fill ? (L.crop.cutPct ? `The picture is cropped to fill ${f(L.posterW)} × ${f(L.posterH)} ${unit}. About ${L.crop.cutPct}% of it is cut off.` : `The picture already has this shape. Nothing is cropped.`) : 'The poster shows your whole image. Nothing is cropped.'}</p>`,
      `<p class="mb-1">${qcheck}</p>`,
      ...tips.map((t, i) => `<p class="mb-1">${t.text} <button type="button" class="font-semibold text-brand-ink underline underline-offset-4" data-fix="${i}">Apply</button></p>`),
    ];
    sum.innerHTML = lines.join('');
    if (!busy) {
      const pages = L.sheets + (($('opt-map') as HTMLInputElement).checked ? 1 : 0);
      dls.forEach((b) => {
        b.disabled = false;
        b.textContent = dlText(b, pages);
      });
      tests.forEach((b) => { b.disabled = L.sheets < 2; });
    }
    saveSettings();
    renderPreview();
    renderCrop();
  }

  $('summary').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-fix]') as HTMLElement | null;
    const t = b && tips[Number(b.dataset.fix)];
    if (!t) return;
    // Round down to a tenth in the shown unit so the new size really drops the thin column or row.
    const shown = Math.floor(showLen(t.fix.inches, unit, 4) * 10 + 1e-6) / 10;
    vals[t.fix.mode] = toInches(shown, unit);
    (document.querySelector(`input[name="mode"][value="${t.fix.mode}"]`) as HTMLInputElement).checked = true;
    syncInputs(); update();
  });

  /* ---------- Image loading ---------- */
  // Phone photos carry a rotation flag. Ask for it explicitly; older browsers fall back to the default.
  async function bitmapOf(blob: Blob): Promise<ImageBitmap> {
    try { return await createImageBitmap(blob, { imageOrientation: 'from-image' }); } catch { return createImageBitmap(blob); }
  }

  // A file that cannot be read must not leave the old picture active: a PDF of the old picture would be a mistake.
  function clearSource(message: string) {
    if (src) URL.revokeObjectURL(src.url);
    src = null; current = null; tips = [];
    $('img-name').textContent = message;
    $('preview-inner').innerHTML = ''; $('crop-svg').innerHTML = '';
    ['st-sheets', 'st-size', 'st-quality', 'bar-sheets', 'bar-size'].forEach((id) => { $(id).textContent = '-'; });
    $('summary').textContent = 'Choose an image to see the poster.';
    (all('.dl-btn') as HTMLButtonElement[]).forEach((b) => { b.disabled = true; b.textContent = dlText(b); });
    (all('.test-btn') as HTMLButtonElement[]).forEach((b) => { b.disabled = true; });
  }

  async function setSource(blob: Blob, name: string, sample = false) {
    if (blob.type === 'image/svg+xml' || (blob.type && !blob.type.startsWith('image/'))) {
      clearSource('Use a JPG, PNG or WebP image. The earlier picture was removed.');
      return;
    }
    try {
      const bmp = await bitmapOf(blob);
      const { width: w, height: h } = bmp;
      bmp.close();
      if (!w || !h) throw new Error('size');
      if (src) URL.revokeObjectURL(src.url);
      src = { blob, url: URL.createObjectURL(blob), w, h, sample };
      $('img-name').textContent = sample
        ? 'Sample picture shown. Choose your own image to replace it.'
        : `${name}, ${w} × ${h} pixels. It stays on your device.`;
      update();
    } catch {
      clearSource('This browser cannot open that file. Try a JPG or PNG image. The earlier picture was removed.');
    }
  }

  // The sample has the shape given by the guide page (or 3:2 on the home page), so its sheet count matches the page text.
  function makeSample(shape: [number, number] = [3, 2]): Promise<Blob> {
    const c = document.createElement('canvas');
    const k = 1800 / Math.max(shape[0], shape[1]);
    c.width = Math.round(shape[0] * k); c.height = Math.round(shape[1] * k);
    return drawSample(c);
  }

  function drawSample(c: HTMLCanvasElement): Promise<Blob> {
    const W = c.width, H = c.height, u = H / 1200;
    const g = c.getContext('2d')!;
    const sky = g.createLinearGradient(0, 0, 0, H * 0.67);
    sky.addColorStop(0, '#2b5fa8'); sky.addColorStop(1, '#f6d7a8');
    g.fillStyle = sky; g.fillRect(0, 0, W, H);
    g.fillStyle = '#fff6d8'; g.beginPath(); g.arc(W * 0.74, H * 0.25, Math.min(130 * u, W * 0.08), 0, Math.PI * 2); g.fill();
    const hill = (y: number, col: string, amp: number, ph: number) => {
      g.fillStyle = col; g.beginPath(); g.moveTo(0, H);
      for (let x = 0; x <= W; x += 10) g.lineTo(x, (y + Math.sin(x / (260 * u) + ph) * amp) * u);
      g.lineTo(W, H); g.closePath(); g.fill();
    };
    hill(640, '#c9794a', 70, 0.5); hill(780, '#8f4a2c', 90, 2); hill(930, '#4a2a22', 60, 4);
    g.fillStyle = '#fff'; g.font = `700 ${Math.min(150 * u, W * 0.11)}px ui-sans-serif, system-ui, sans-serif`; g.textAlign = 'center';
    g.fillText('Your poster', W / 2, H * 0.925);
    return new Promise((res) => c.toBlob((b) => res(b!), 'image/png'));
  }

  const fileInput = $<HTMLInputElement>('file');
  fileInput.addEventListener('change', () => { const f = fileInput.files?.[0]; if (f) setSource(f, f.name); });
  // A file dropped anywhere on the page loads here. Without this the browser would open the file and leave the tool.
  const drop = $('drop');
  ['dragenter', 'dragover'].forEach((ev) => document.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('ring-2', 'ring-brand'); }));
  document.addEventListener('dragleave', (e) => { if (!(e as DragEvent).relatedTarget) drop.classList.remove('ring-2', 'ring-brand'); });
  document.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('ring-2', 'ring-brand');
    const f = (e as DragEvent).dataTransfer?.files?.[0];
    if (f) setSource(f, f.name);
  });
  document.addEventListener('paste', (e) => {
    const f = Array.from(e.clipboardData?.files || []).find((x) => x.type.startsWith('image/'));
    if (f) setSource(f, f.name || 'Pasted image');
  });

  /* ---------- Settings ---------- */
  sizeInput.addEventListener('input', () => {
    const v = parseFloat(sizeInput.value);
    const m = mode();
    // Whole pages only for "pages across".
    vals[m] = isNaN(v) ? 0 : m === 'across' ? Math.round(v) : toInches(v, unit);
    update();
  });
  sizeInput.addEventListener('change', syncInputs); // show the value that was used, for example 1.5 becomes 2
  const nudge = (d: number) => {
    const m = mode(), step = stepFor(m);
    if (m === 'across') vals.across = Math.max(1, (vals.across || 0) + d);
    else vals[m] = toInches(Math.max(step, showLen(vals[m] || 0, unit) + d * step), unit);
    syncInputs(); update();
  };
  $('size-minus').addEventListener('click', () => nudge(-1));
  $('size-plus').addEventListener('click', () => nudge(1));
  all('input[name="mode"]').forEach((e) => e.addEventListener('change', () => { syncInputs(); update(); }));
  all('input[name="unit"]').forEach((e) => e.addEventListener('change', () => {
    unit = radio('unit') as 'in' | 'cm';
    syncInputs(); update();
  }));
  marginInput.addEventListener('input', () => { const v = parseFloat(marginInput.value); marginIn = isNaN(v) ? NaN : toInches(v, unit); update(); });
  overlapInput.addEventListener('input', () => { const v = parseFloat(overlapInput.value); overlapIn = isNaN(v) ? NaN : toInches(v, unit); update(); });
  all('input[name="fit"]').forEach((e) => e.addEventListener('change', () => { syncInputs(); update(); }));
  const fillInput = (el: HTMLInputElement, key: 'width' | 'height') => el.addEventListener('input', () => {
    const v = parseFloat(el.value);
    vals[key] = isNaN(v) ? 0 : toInches(v, unit);
    update();
  });
  fillInput(fillW, 'width'); fillInput(fillH, 'height');
  fillW.addEventListener('change', syncInputs); fillH.addEventListener('change', syncInputs);
  ['paper', 'opt-map'].forEach((id) => $(id).addEventListener('input', update));
  all('input[name="orient"]').forEach((e) => e.addEventListener('change', update));

  /* ---------- PDF ---------- */
  const isIOS = /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

  // Canvas limits: iOS Safari allows about 16 million pixels, other browsers about 64 million and 10000 px per side.
  const MAX_SIDE = isIOS ? 4096 : 10000;
  const MAX_PIXELS = isIOS ? 16e6 : 64e6;
  const MAX_DPI = 200; // above this a home printer shows no gain, and the PDF only gets heavier
  const JPEG_QUALITY = 0.92;

  // area is the part of the picture to keep, in picture pixels. Fill uses it to cut the picture to the poster shape.
  async function prepareJpeg(blob: Blob, posterIn: number, area: { sx: number; sy: number; sw: number; sh: number }): Promise<Uint8Array> {
    const bmp = await bitmapOf(blob);
    const sx = Math.round(area.sx), sy = Math.round(area.sy);
    const sw = Math.max(1, Math.min(bmp.width - sx, Math.round(area.sw))), sh = Math.max(1, Math.min(bmp.height - sy, Math.round(area.sh)));
    let scale = Math.min(1, MAX_SIDE / Math.max(sw, sh), Math.sqrt(MAX_PIXELS / (sw * sh)), (MAX_DPI * posterIn) / sw);
    for (let attempt = 0; attempt < 5; attempt++) {
      const c = document.createElement('canvas');
      c.width = Math.max(1, Math.round(sw * scale));
      c.height = Math.max(1, Math.round(sh * scale));
      const g = c.getContext('2d');
      if (g) {
        g.fillStyle = '#fff'; g.fillRect(0, 0, c.width, c.height);
        g.imageSmoothingQuality = 'high';
        g.drawImage(bmp, sx, sy, sw, sh, 0, 0, c.width, c.height);
        const out: Blob | null = await new Promise((res) => c.toBlob(res, 'image/jpeg', JPEG_QUALITY));
        if (out && out.size > 0) { bmp.close(); return new Uint8Array(await out.arrayBuffer()); }
      }
      scale *= 0.7; // the browser refused the canvas, so try a smaller one
    }
    bmp.close();
    throw new Error('canvas');
  }

  async function download(test = false) {
    if (!src || !current || !current.ok || busy) return;
    const L = current, btns = all('.dl-btn, .test-btn') as HTMLButtonElement[];
    busy = true; btns.forEach((b) => { b.disabled = true; if (b.classList.contains('dl-btn')) b.textContent = b.classList.contains('bar-btn') ? 'Building...' : 'Building PDF...'; });
    setStatus('Preparing your image...', 'progress');
    try {
      const [lib, { buildPdf }] = await Promise.all([import('pdf-lib'), import('../lib/pdf.js')]);
      const jpg = await prepareJpeg(src.blob, L.posterW, L.crop);
      const bytes = await buildPdf(lib, L, { bytes: jpg, type: 'jpg' }, {
        marks: ($('opt-marks') as HTMLInputElement).checked,
        labels: ($('opt-labels') as HTMLInputElement).checked,
        map: ($('opt-map') as HTMLInputElement).checked,
        unit,
        only: test ? [0, 0] : null,
      }, (d: number, t: number) => setStatus(`Building page ${d} of ${t}...`, 'progress'));
      const url = URL.createObjectURL(new Blob([bytes as BlobPart], { type: 'application/pdf' }));
      const a = document.createElement('a');
      a.href = url; a.download = test ? 'poster-test-page-A1.pdf' : `poster-${L.cols}x${L.rows}-pages.pdf`;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 60000);
      setStatus(test ? 'Done. Print page A1 at 100% (Actual size) and check the size and the margins. Then download the full PDF.' : 'Done. Open the PDF and print at 100% (Actual size). Do not choose Fit to page.', 'done');
    } catch {
      setStatus('The PDF could not be built. Try a smaller image or a smaller poster.', 'failed');
    } finally {
      busy = false; update();
    }
  }
  all('.dl-btn').forEach((b) => b.addEventListener('click', () => download(false)));
  all('.test-btn').forEach((b) => b.addEventListener('click', () => download(true)));

  /* ---------- Saved settings ---------- */
  // The last settings stay in this browser only. A landing page preset wins over saved settings.
  const KEY = 'poster-tiler-settings-v1';
  const checks = ['opt-marks', 'opt-labels', 'opt-map'];
  function saveSettings() {
    if ($('tool').dataset.preset) return; // a landing page must not overwrite the home page settings
    try {
      localStorage.setItem(KEY, JSON.stringify({
        paper: ($('paper') as HTMLSelectElement).value, orient: radio('orient'), fit: radio('fit'), mode: mode(), unit, vals, marginIn, overlapIn,
        checks: checks.map((id) => ($(id) as HTMLInputElement).checked),
      }));
    } catch { /* storage is blocked: the tool still works */ }
  }
  const num = (v: unknown, fallback: number) => (typeof v === 'number' && isFinite(v) ? v : fallback);
  function applySettings(s: any) {
    if (!s || typeof s !== 'object') return;
    const paperSel = $('paper') as HTMLSelectElement;
    if (typeof s.paper === 'string' && s.paper in PAPER_KEYS) paperSel.value = s.paper;
    const pick = (name: string, v: unknown, ok: string[]) => {
      const el = typeof v === 'string' && ok.includes(v) ? document.querySelector<HTMLInputElement>(`input[name="${name}"][value="${v}"]`) : null;
      if (el) el.checked = true;
    };
    pick('orient', s.orient, ['portrait', 'landscape']);
    pick('fit', s.fit, ['fit', 'fill']);
    pick('mode', s.mode, ['across', 'width', 'height']);
    pick('unit', s.unit, ['in', 'cm']);
    unit = radio('unit') as 'in' | 'cm';
    if (s.vals) { vals.across = Math.round(num(s.vals.across, 3)) || 3; vals.width = num(s.vals.width, 24); vals.height = num(s.vals.height, 36); }
    marginIn = num(s.marginIn, 0.25);
    overlapIn = num(s.overlapIn, 0.5);
    if (Array.isArray(s.checks)) checks.forEach((id, i) => { if (typeof s.checks[i] === 'boolean') ($(id) as HTMLInputElement).checked = s.checks[i]; });
  }
  const PAPER_KEYS = Object.fromEntries(Array.from(($('paper') as HTMLSelectElement).options).map((o) => [o.value, 1]));
  const presetRaw = $('tool').dataset.preset;
  if (presetRaw) {
    const p = JSON.parse(presetRaw);
    const m = p.mode as 'across' | 'width' | 'height';
    const v = Number(p.value);
    applySettings({ paper: p.paper, orient: p.orient, mode: m, unit: p.unit, fit: p.fit === 'fill' ? 'fill' : 'fit' });
    if (m === 'across') vals.across = v; else vals[m] = toInches(v, unit);
    if (p.fit === 'fill') { vals.width = toInches(p.w, unit); vals.height = toInches(p.h, unit); }
  } else {
    try { applySettings(JSON.parse(localStorage.getItem(KEY) || 'null')); } catch { /* ignore a bad saved value */ }
  }
  ['opt-marks', 'opt-labels'].forEach((id) => $(id).addEventListener('change', saveSettings));

  /* ---------- Start ---------- */
  syncInputs();
  let shape: [number, number] | undefined;
  try { const sh = presetRaw && JSON.parse(presetRaw).shape; if (Array.isArray(sh) && sh[0] > 0 && sh[1] > 0) shape = [sh[0], sh[1]]; } catch { /* use the default shape */ }
  makeSample(shape).then((b) => setSource(b, 'Sample', true));
</script>
